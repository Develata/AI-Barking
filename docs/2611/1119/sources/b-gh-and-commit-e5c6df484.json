      "patch": "@@ -3708,15 +3708,15 @@\n     </plurals>\n \n     <!-- Bottom sheet message shown after an assistant app requested the contents of the screen, explaining that screenshots were automatically disabled -->\n-    <string name=\"AssistantScreenSecurityBottomSheet__body\" translatable=\"false\">Screenshots have been disabled</string>\n+    <string name=\"AssistantScreenSecurityBottomSheet__body\">AI assistant apps like Gemini can scan your Signal content. To prevent this, screen security has been enabled. This will also disable screenshots.</string>\n     <!-- Bottom sheet title shown after an assistant app requested the contents of the screen and screen security was automatically turned on -->\n     <string name=\"AssistantScreenSecurityBottomSheet__title\">Screen security is enabled</string>\n     <!-- Bottom sheet button that turns screen security back off -->\n     <string name=\"AssistantScreenSecurityBottomSheet__turn_off_screen_security\">Turn off screen security</string>\n     <!-- Title of the dialog confirming that the user wants to turn off screen security -->\n     <string name=\"AssistantScreenSecurityTurnOffDialog__title\">Turn off screen security?</string>\n     <!-- Body of the dialog confirming that the user wants to turn off screen security -->\n-    <string name=\"AssistantScreenSecurityTurnOffDialog__body\" translatable=\"false\">Enable screenshots?</string>\n+    <string name=\"AssistantScreenSecurityTurnOffDialog__body\">If turned off, this may allow AI assistants such as Google Gemini to scan Signal content and use it for features that may not be private.</string>\n     <!-- Dialog button that confirms turning off screen security -->\n     <string name=\"AssistantScreenSecurityTurnOffDialog__turn_off\">Turn off</string>\n     <!-- Snackbar shown after the user turns off screen security -->"
    }
  ]
