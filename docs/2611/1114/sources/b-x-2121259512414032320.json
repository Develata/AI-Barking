o/mp4"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/480x600/ZAjGW_s_p_dE4uKq.mp4?tag=29","bitrate":950000,"content_type":"video/mp4"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/720x900/8jS2qMPBjQaauLx1.mp4?tag=29","bitrate":2176000,"content_type":"video/mp4"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/1080x1350/LDhzufFizXDo_vL9.mp4?tag=29","bitrate":10368000,"content_type":"video/mp4"}]}],"videos":[{"id":"2121259428716691456","url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/1080x1350/LDhzufFizXDo_vL9.mp4?tag=29","thumbnail_url":"https://pbs.twimg.com/amplify_video_thumb/2121259428716691456/img/UsEKWta0EjB_DorW.jpg","duration":6.5,"width":1080,"height":1350,"format":"video/mp4","type":"video","formats":[{"url":"https://video.twimg.com/amplify_video/2121259428716691456/pl/mB7xkW4-yZ47-tfD.m3u8?tag=29","container":"m3u8"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/320x400/AHTAJ6I3MAcHod-a.mp4?tag=29","bitrate":632000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/480x600/ZAjGW_s_p_dE4uKq.mp4?tag=29","bitrate":950000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/720x900/8jS2qMPBjQaauLx1.mp4?tag=29","bitrate":2176000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/1080x1350/LDhzufFizXDo_vL9.mp4?tag=29","bitrate":10368000,"container":"mp4","codec":"h264"}],"publisher":null,"variants":[{"url":"https://video.twimg.com/amplify_video/2121259428716691456/pl/mB7xkW4-yZ47-tfD.m3u8?tag=29","bitrate":0,"content_type":"application/x-mpegURL"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/320x400/AHTAJ6I3MAcHod-a.mp4?tag=29","bitrate":632000,"content_type":"video/mp4"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/480x600/ZAjGW_s_p_dE4uKq.mp4?tag=29","bitrate":950000,"content_type":"video/mp4"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/720x900/8jS2qMPBjQaauLx1.mp4?tag=29","bitrate":2176000,"content_type":"video/mp4"},{"url":"https://video.twimg.com/amplify_video/2121259428716691456/vid/avc1/1080x1350/LDhzufFizXDo_vL9.mp4?tag=29","bitrate":10368000,"content_type":"video/mp4"}]}]},"quote":{"url":"https://x.com/jakubjurovych/status/2121256499552915586","id":"2121256499552915586","text":"What’s the best model for proactive agents?\n\nToday, we’re introducing the Agent Initiative Benchmark. We tested 12 frontier models on realistic workplace tasks inside a synthetic company with 6 years of highly detailed history: it has a financial model, CRM records, past-due invoices, Linear tickets, and real-life events affecting company development - competitor product announcements, SVB collapse, etc.\n\nWe used the company’s Slack to test how a proactive agent listening in on each conversation would assist the team in day-to-day tasks: from stepping in to align initiatives across teams to warning the team not to use an unapproved customer logo.\n\nHighlights:\n\n- 6.1 Sol and Astra from @OpenAIDevs beat Anthropic's latest Fable 5.2, with Sol crushing it at both performance and cost ($0.11 per task vs $1.87).\n- The most expensive models aren't the best: Fable 5.1 is 430x more expensive than GPT-6 Luna, with similar performance.\n- Most models try to help even if they're not needed. Interestingly, in these failure cases, they spend more time thinking, and the unnecessary work takes about 80% more time and money than if they stayed quiet.\n\nIf you’re building agents, keep reading for more tips on which model is best for your use case. Detailed breakdown, the open-source dataset, and benchmark code below:","raw_text":{"text":"What’s the best model for proactive agents?\n\nToday, we’re introducing the Agent Initiative Benchmark. We tested 12 frontier models on realistic workplace tasks inside a synthetic company with 6 years of highly detailed history: it has a financial model, CRM records, past-due invoices, Linear tickets, and real-life events affecting company development - competitor product announcements, SVB collapse, etc.\n\nWe used the company’s Slack to test how a proactive agent listening in on each conversation would assist the team in day-to-day tasks: from stepping in to align initiatives across teams to warning the team not to use an unapproved customer logo.\n\nHighlights:\n\n- 6.1 Sol and Astra from @OpenAIDevs beat Anthropic's latest Fable 5.2, with Sol crushing it at both performance and cost ($0.11 per task vs $1.87).\n- The most expensive models aren't the best: Fable 5.1 is 430x more expensive than GPT-6 Luna, with similar performance.\n- Most models try to help even if they're not needed. Interestingly, in these failure cases, they spend more time thinking, and the unnecessary work takes about 80% more time and money than if they stayed quiet.\n\nIf you’re building agents, keep reading for more tips on which model is best for your use case. Detailed breakdown, the open-source dataset, and benchmark code below:","display_text_range":[0,1318],"facets":[{"type":"media","indices":[276,299],"id":"2121252641518895104","display":"pic.x.com/9FbZ9Nur9l","original":"https://t.co/9FbZ9Nur9l","replacement":"https://x.com/jakubjurovych/status/2121256499552915586/video/1"},{"type":"mention","indices":[694,705],"original":"OpenAIDevs","id":"1633874951508721686"}]},"author":{"screen_name":"jakubjurovych","url":"https://x.com/jakubjurovych","id":"42959303","followers":3977,"following":320,"likes":387,"media_count":102,"name":"Jakub Jurovych","description":"Founder @DeepnoteHQ. HCI, data agents, computational notebooks.","raw_description":{"text":"Founder @DeepnoteHQ. HCI, data agents, computational notebooks.","facets":[]},"location":"","banner_url":"https://pbs.twimg.com/profile_banners/42959303