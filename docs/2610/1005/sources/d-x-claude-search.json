      },
      "quoted_url": "https://twitter.com/claudeai/status/2102435511222890900",
      "quoted": {
        "id": "2102435511222890900",
        "text": "Introducing Claude Opus 5.5, the first model in our new Claude 5.5 family.\n\nIt performs at the level of Claude Fable 5.1 for most tasks, and costs 40% less to run than Opus 5. https://t.co/Q9C2VKQ79f",
        "created_at": "2026-09-22T16:31:01.000Z",
        "is_quote_status": false,
        "author": "claudeai",
        "likes": 97091,
        "replies": 3344,
