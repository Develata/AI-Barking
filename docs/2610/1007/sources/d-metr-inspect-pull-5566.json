  "title": "Let tasks and the viewer mark log content untrusted so it shows as plain text",
  "user": {
    "login": "brandly",
    "id": 820696,
    "node_id": "MDQ6VXNlcjgyMDY5Ng==",
    "avatar_url": "https://avatars.githubusercontent.com/u/820696?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/brandly",
    "html_url": "https://github.com/brandly",
    "followers_url": "https://api.github.com/users/brandly/followers",
    "following_url": "https://api.github.com/users/brandly/following{/other_user}",
    "gists_url": "https://api.github.com/users/brandly/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/brandly/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/brandly/subscriptions",
    "organizations_url": "https://api.github.com/users/brandly/orgs",
    "repos_url": "https://api.github.com/users/brandly/repos",
    "events_url": "https://api.github.com/users/brandly/events{/privacy}",
    "received_events_url": "https://api.github.com/users/brandly/received_events",
