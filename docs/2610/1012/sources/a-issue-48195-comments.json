-30T01:46:37Z","updated_at":"2026-09-30T01:46:37Z","body":"This is terrible. I can't input anything on the CLI at all. You should fix this problem as soon as possible and give us 100 banked reset!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openai/codex/issues/comments/5902442558/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openai/codex/issues/comments/5968781597","html_url":"https://github.com/openai/codex/issues/48195#issuecomment-5968781597","issue_url":"https://api.github.com/repos/openai/codex/issues/48195","id":5968781597,"node_id":"IC_kwDOOYsS4c8AAAABY8RhHQ","user":{"login":"aetherxeg-source","id":313120732,"node_id":"U_kgDOEqnX3A","avatar_url":"https://avatars.githubusercontent.com/u/313120732?v=4","gravatar_id":"","url":"https://api.github.com/users/aetherxeg-source","html_url":"https://github.com/aetherxeg-source","followers_url":"https://api.github.com/users/aetherxeg-source/followers","following_url":"https://api.github.com/users/aetherxeg-source/following{/other_user}","gists_url":"https://api.github.com/users/aetherxeg-source/gists{/gist_id}","starred_url":"https://api.github.com/users/aetherxeg-source/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aetherxeg-source/subscriptions","organizations_url":"https://api.github.com/users/aetherxeg-source/orgs","repos_url":"https://api.github.com/users/aetherxeg-source/repos","events_url":"https://api.github.com/users/aetherxeg-source/events{/privacy}","received_events_url":"https://api.github.com/users/aetherxeg-source/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-03T11:36:50Z","updated_at":"2026-10-03T11:36:50Z","body":"There is a useful provenance boundary behind this request:\n\n`installed CLI identity != daemon execution identity`\n\nOnce the CLI copies itself into a managed release directory and a background updater can replace that copy, the process that services a later turn is no longer necessarily the artifact the user explicitly installed or invoked.\n\nI would make the daemon expose a small execution receipt for each client attachment containing at least:\n\n`client_cli_version + daemon_binary_digest + daemon_generation + updater_state + inherited_environment_generation`\n\nThen a client can distinguish:\n\n- same installed artifact, same daemon generation;\n- same CLI but different daemon generation;\n- daemon binary changed independently of the package-manager state;\n- daemon inherited environment from an earlier session.\n\nA strong regression would start the daemon under environment A, attach from environment B, update the installed CLI, and verify that the client can see exactly which daemon generation/binary/environment is authoritative for the turn rather than inferring it from the foreground CLI version.\n\nRelated runtime behavioral-integrity work: https://github.com/AETHERXGLOBAL/execsurface","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openai/codex/issues/comments/5968781597/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}