_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]},"minimized":null},{"url":"https://api.github.com/repos/openai/codex/issues/comments/5953229001","html_url":"https://github.com/openai/codex/issues/50299#issuecomment-5953229001","issue_url":"https://api.github.com/repos/openai/codex/issues/50299","id":5953229001,"node_id":"IC_kwDOOYsS4c8AAAABYtcQyQ","user":{"login":"aetherxeg-source","id":313120732,"node_id":"U_kgDOEqnX3A","avatar_url":"https://avatars.githubusercontent.com/u/313120732?v=4","gravatar_id":"","url":"https://api.github.com/users/aetherxeg-source","html_url":"https://github.com/aetherxeg-source","followers_url":"https://api.github.com/users/aetherxeg-source/followers","following_url":"https://api.github.com/users/aetherxeg-source/following{/other_user}","gists_url":"https://api.github.com/users/aetherxeg-source/gists{/gist_id}","starred_url":"https://api.github.com/users/aetherxeg-source/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aetherxeg-source/subscriptions","organizations_url":"https://api.github.com/users/aetherxeg-source/orgs","repos_url":"https://api.github.com/users/aetherxeg-source/repos","events_url":"https://api.github.com/users/aetherxeg-source/events{/privacy}","received_events_url":"https://api.github.com/users/aetherxeg-source/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-02T13:16:30Z","updated_at":"2026-10-02T13:16:30Z","body":"A useful lifecycle invariant here is:\n\n`daemon replacement != logical execution continuity`\n\nA TUI reconnect proving that a new app-server process is reachable does not prove that the in-flight turn, its execution generation, or any already-issued effects were restored.\n\nI would make restart admission depend on explicit active-turn leases, and make recovery evidence bind at least:\n\n```text\nthread/session identity\nturn generation\nactive tool/effect attempts\nlast durable checkpoint\nold daemon generation\nnew daemon generation\n-> restored | deferred | unrecoverable\n```\n\nTwo properties seem important:\n\n1. an updater check with no new binary must not create a new daemon generation at all;\n2. if a real replacement is required, `initialize` success is not sufficient to report recovery—the exact in-flight turn generation must either resume or be marked explicitly unrecoverable.\n\nA strong fault-injection test would restart the daemon at several points around a side-effecting tool call: before dispatch, after dispatch but before result persistence, and after result persistence but before turn completion. After reconnect, the effect count must remain exactly one and the TUI must not silently create a fresh execution attempt.\n\nThat separates transport liveness from execution continuity: `new daemon reachable` is useful evidence, but it is not proof that the old logical execution survived.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openai/codex/issues/comments/5953229001/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"minimized":null},{"url":"https://api.github.com/repos/openai/codex/issues/comments/5953809838","html_url":"https://github.com/openai/codex/issues/50299#issuecomment-5953809838","issue_url":"https://api.github.com/repos/openai/codex/issues/50299","id":5953809838,"node_id":"IC_kwDOOYsS4c8AAAABYt_trg","user":{"login":"aetherxeg-source","id":313120732,"node_id":"U_kgDOEqnX3A","avatar_url":"https://avatars.githubusercontent.com/u/313120732?v=4","gravatar_id":"","url":"https://api.github.com/users/aetherxeg-source","html_url":"https://github.com/aetherxeg-source","followers_url":"https://api.github.com/users/aetherxeg-source/followers","following_url":"https://api.github.com/users/aetherxeg-source/following{/other_user}","gists_url":"https://api.github.com/users/aetherxeg-source/gists{/gist_id}","starred_url":"https://api.github.com/users/aetherxeg-source/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aetherxeg-source/subscriptions","organizations_url":"https://api.github.com/users/aetherxeg-source/orgs","repos_url":"https://api.github.com/users/aetherxeg-source/repos","events_url":"https://api.github.com/users/aetherxeg-source/events{/privacy}","received_events_url":"https://api.github.com/users/aetherxeg-source/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-02T13:48:08Z","updated_at":"2026-10-02T13:48:08Z","body":"A daemon-upgrade invariant worth enforcing is:\n\n`binary replacement != session continuity`\n\nAn updater can successfully install and start a new daemon while still violating the contract of every attached turn. The upgrade boundary therefore needs to reason about active execution ownership, not only package version.\n\nI would separate:\n\n`update available -> replacement prepared -> active-turn drain decision -> session handoff checkpoint -> daemon replacement -> attachment restoration`\n\nand give each attached turn a durable execution/session generation. A replacement is safe only if the new daemon can prove it adopted that generation or the old daemon reached an explicit quiescent terminal state first.\n\nA useful adversarial test is an update check during a long tool call with no new release available, followed by the same test when a real new binary exists. The no-op check must cause zero daemon-generation changes. For a real update, inject failure after the new daemon starts but before client reattachment; recovery must either reconnect to the exact existing turn or report a typed non-restorable state without silently abandoning it.\n\nAlso test repeated hourly checks with identical selected-binary digest: the replacement generation should remain unchanged. That would distinguish update polling from execution-affecting replacement and make \"nothing changed\" mechanically non-disruptive.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openai/codex/issues/comments/5953809838/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"minimized":null},{"url":"https://api.github.com/repos/openai/codex/issues/comments/5953834701","html_url":"https://github.com/openai/codex/issues/50299#issuecomment-5953834701","issue_url":"https://api.github.com/repos/openai/codex/issues/50299","id":5953834701,"node_id":"IC_kwDOOYsS4c8AAAABYuBOzQ","user":{"login":"hsmnzaydn","id":20016330,"node_id":"MDQ6VXNlcjIwMDE2MzMw","avatar_url":"https://avatars.githubusercontent.com/u/20016330?v=4","gravatar_id":"","url":"https://api.github.com/users/hsmnzaydn","html_url":"https://github.com/hsmnzaydn","followers_url":"https://api.github.com/users/hsmnzaydn/followers","following_url":"https://api.github.com/users/hsmnzaydn/following{/other_user}","gists_url":"https://api.github.com/users/hsmnzaydn/gists{/gist_id}","starred_url":"https://api.github.com/users/hsmnzaydn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hsmnzaydn/subscriptions","organizations_url":"https://api.github.com/users/hsmnzaydn/orgs","repos_url":"https://api.github.com/users/hsmnzaydn/repos","events_url":"https://api.github.com/users/hsmnzaydn/events{/privacy}","received_events_url":"https://api.github.com/users/hsmnzaydn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-02T13:49:44Z","updated_at":"2026-10-02T13:49:44Z","body":"Not a duplicate of #49865, but related. In #49865 the session resumes with the wrong permissions. Here the session does not resume at all: the TUI ends at \"app-server session could not be restored / Reconnect failed\", and the in-progress turn never completes. Both seem to come from the same restart path, where the daemon is replaced while turns are attached. #49229 also looks related: after reconnect, the thread resumes with workspace-write.\n\nThe part specific to this report is the hourly cadence. Drains happened at 22:21Z and 23:22Z with no new release. That points to the scheduled updater choosing an `Always` restart on every check (a mismatch between the updater digest and the selected binary that never settles after handoff), not to a one-time upgrade.\n\nSetting `updater.autoUpdateEnabled: false` and then running `codex app-server daemon start` stopped the failures on our side. Since then, no restarts and no stranded sessions.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openai/codex/issues/comments/5953834701/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openai/codex/issues/comments/5953856631","html_url":"https://github.com/openai/codex/issues/50299#issuecomment-5953856631","issue_url":"https://api.github.com/repos/openai/codex/issues/50299","id":5953856631,"node_id":"IC_kwDOOYsS4c8AAAABYuCkdw","user":{"login":"hsmnzaydn","id":20016330,"node_id":"MDQ6VXNlcjIwMDE2MzMw","avatar_url":"https://avatars.githubusercontent.com/u/20016330?v=4","gravatar_id":"","url":"https://api.github.com/users/hsmnzaydn","html_url":"https://github.com/hsmnzaydn","followers_url":"https://api.github.com/users/hsmnzaydn/followers","following_url":"https://api.github.com/users/hsmnzaydn/following{/other_user}","gists_url":"https://api.github.com/users/hsmnzaydn/gists{/gist_id}","starred_url":"https://api.github.com/users/hsmnzaydn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hsmnzaydn/subscriptions","organizations_url":"https://api.github.com/users/hsmnzaydn/orgs","repos_url":"https://api.github.com/users/hsmnzaydn/repos","events_url":"https://api.github.com/users/hsmnzaydn/events{/privacy}","received_events_url":"https://api.github.com/users/hsmnzaydn/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-02T13:50:46Z","updated_at":"2026-10-02T13:50:46Z","body":"@aetherxeg-source thanks, this is a useful way to frame it. \"Daemon reachable\" versus \"the same turn resumed\" is the distinction we kept missing while debugging: the replacement daemon answered `initialize` within seconds, yet the attached turns never came back.\n\nBoth of your test properties match what we saw. A no-op hourly check should not create a new daemon generation, and a real replacement should end each in-flight turn as either resumed or explicitly unrecoverable, never silently stalled. On our side, that last part would also have let the orchestrator mark the workers failed instead of waiting for hours.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openai/codex/issues/comments/5953856631/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openai/codex/issues/comments/5967958945","html_url":"https://github.com/openai/codex/issues/50299#issuecomment-5967958945","issue_url":"https://api.github.com/repos/openai/codex/issues/50299","id":5967958945,"node_id":"IC_kwDOOYsS4c8AAAABY7fToQ","user":{"login":"aetherxeg-source","id":313120732,"node_id":"U_kgDOEqnX3A","avatar_url":"https://avatars.githubusercontent.com/u/313120732?v=4","gravatar_id":"","url":"https://api.github.com/users/aetherxeg-source","html_url":"https://github.com/aetherxeg-source","followers_url":"https://api.github.com/users/aetherxeg-source/followers","following_url":"https://api.github.com/users/aetherxeg-source/following{/other_user}","gists_url":"https://api.github.com/users/aetherxeg-source/gists{/gist_id}","starred_url":"https://api.github.com/users/aetherxeg-source/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aetherxeg-source/subscriptions","organizations_url":"https://api.github.com/users/aetherxeg-source/orgs","repos_url":"https://api.github.com/users/aetherxeg-source/repos","events_url":"https://api.github.com/users/aetherxeg-source/events{/privacy}","received_events_url":"https://api.github.com/users/aetherxeg-source/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-03T09:53:11Z","updated_at":"2026-10-03T09:53:11Z","body":"That matches the distinction I was trying to isolate.\n\nOne concrete way to make it observable would be to persist a small recovery receipt per in-flight turn across daemon replacement, for example:\n\n\"{thread_id, turn_generation, old_daemon_generation, new_daemon_generation, recovery_state}\"\n\nwhere \"recovery_state\" is one of:\n\n\"restored | explicitly_failed | not_adopted\"\n\nThe important part is that \"initialize\" / daemon reachability must never be allowed to imply \"restored\".\n\nA useful invariant for the handoff boundary would be:\n\n\"turn_restored => new daemon proves ownership of the exact prior turn generation\"\n\nand otherwise the turn must transition to an explicit terminal recovery failure.\n\nThat would also give orchestration a deterministic signal instead of forcing it to infer failure from a permanently stalled turn.\n\nThe strongest fault-injection test would still be around an in-flight side effect:\n\n- old daemon dispatches effect;\n- replacement occurs before result persistence;\n- new daemon reconnects;\n- recovery must neither replay the effect nor silently abandon the turn.\n\nSo the post-restart evidence should prove both:\n\n\"execution continuity\"\n\nand\n\n\"effect uniqueness\"\n\nrather than only transport liveness.\n\nRelated runtime behavioral-integrity work:\nhttps://github.com/AETHERXGLOBAL/execsurface","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openai/codex/issues/comments/5967958945/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openai/codex/issues/comments/5970421966","html_url":"https://github.com/openai/codex/issues/50299#issuecomment-5970421966","issue_url":"https://api.github.com/repos/openai/codex/issues/50299","id":5970421966,"node_id":"IC_kwDOOYsS4c8AAAABY91ozg","user":{"login":"etraut-openai","id":223546144,"node_id":"U_kgDODVMLIA","avatar_url":"https://avatars.githubusercontent.com/u/223546144?v=4","gravatar_id":"","url":"https://api.github.com/users/etraut-openai","html_url":"https://github.com/etraut-openai","followers_url":"https://api.github.com/users/etraut-openai/followers","following_url":"https://api.github.com/users/etraut-openai/following{/other_user}","gists_url":"https://api.github.com/users/etraut-openai/gists{/gist_id}","starred_url":"https://api.github.com/users/etraut-openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/etraut-openai/subscriptions","organizations_url":"https://api.github.com/users/etraut-openai/orgs","repos_url":"https://api.github.com/users/etraut-openai/repos","events_url":"https://api.github.com/users/etraut-openai/events{/privacy}","received_events_url":"https://api.github.com/users/etraut-openai/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-03T15:08:48Z","updated_at":"2026-10-03T15:08:48Z","body":"Thanks for bug report. We have a fix in place, and this will be included in a future release, probably 0.162.0.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/openai/codex/issues/comments/5970421966/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":3,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]