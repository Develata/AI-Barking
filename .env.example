# 复制为 .env 后填写；.env 不入库。说明见 docs/workflow/publish.md。
OPENLIST_URL=https://openlist.develata.me
OPENLIST_USERNAME=
OPENLIST_PASSWORD=
# 用户基本路径为 / 时填 /AI-Barking；基本路径已限定为 /AI-Barking 时填 /
OPENLIST_ROOT=/AI-Barking
# publish-check 身份检查：抓取时登录的 X 账号 handle（不带 @，多个用 ; 分隔）；显示名、头像 ID 由工具自动解析并缓存在仓库外
BARKING_IDENTITY_HANDLES=
# 可选：X 之外的身份片段（如 Reddit 用户名），; 分隔，至少 4 个字符；只写在 .env 里
BARKING_IDENTITY_PATTERNS=